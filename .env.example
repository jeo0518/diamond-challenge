# Copy this file to `.env` (cp .env.example .env). Never commit `.env`.

# SQLite database file (created inside the prisma/ folder).
DATABASE_URL="file:./dev.db"

# Secret used to sign login cookies. Required.
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Default map center when the browser won't share location.
# (These coordinates are downtown Austin, TX — change to wherever you test.)
DEFAULT_LAT="30.2672"
DEFAULT_LNG="-97.7431"

# Time zone for restaurants' pickup/delivery times (an IANA name).
# Servers often run on UTC, so the app never uses the server's own clock setting.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
APP_TIME_ZONE="America/Chicago"

# Who can approve new restaurants at /admin/restaurants (comma-separated emails).
# New restaurants stay hidden from customers until an admin approves them.
# Use CUSTOMER accounts for admins (so they can also preview restaurant pages).
# The sample customer is listed here so you can try it locally — use real emails on the live site.
ADMIN_EMAILS="customer@example.com"

# Set to "false" to hide all [SAMPLE] restaurants from search.
SHOW_SAMPLE_RESTAURANTS="true"
