# Copy this file to `.env` (cp .env.example .env). Never commit `.env`.

# SQLite database file (created inside the prisma/ folder).
DATABASE_URL="file:./dev.db"

# Secret used to sign login cookies. Required.
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Default map center when the browser won't share location.
# (These coordinates are downtown Austin, TX — change to wherever you test.)
DEFAULT_LAT="30.2672"
DEFAULT_LNG="-97.7431"

# Set to "false" to hide all [SAMPLE] restaurants from search.
SHOW_SAMPLE_RESTAURANTS="true"
